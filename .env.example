# Copy to .env.local (local) and add the same names in Vercel → Settings → Environment Variables.
# Never commit .env.local. Never put a secret in a NEXT_PUBLIC_ variable.

# --- LLM (OpenAI-compatible) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# --- Tokenomist ---
TOKENOMIST_API_KEY=

# --- Avalanche Fuji ---
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_TUSDC_ADDRESS=
NEXT_PUBLIC_FAKE_AIRDROP_ADDRESS=
NEXT_PUBLIC_CERT_ADDRESS=
NEXT_PUBLIC_TUTOR_ADDRESS=

# Server only: team minter/deployer wallet (testnet only, never a wallet with real funds)
MINTER_PRIVATE_KEY=

# Server only: random string for signing pass receipts (e.g. `openssl rand -hex 32`)
RECEIPT_SECRET=
